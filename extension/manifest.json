{
  "manifest_version": 3,
  "name": "Browser Volume",
  "version": "0.3.0",
  "description": "Boost quiet tabs up to 1000% with a clean limiter, then control the volume from your phone over a private link.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "vol-up": { "suggested_key": { "default": "Alt+2" }, "description": "Volume +10%" },
    "vol-down": { "suggested_key": { "default": "Alt+1" }, "description": "Volume -10%" }
  }
}
